# ----------------------------------------------------------------------
# Backend
# ----------------------------------------------------------------------
# Demo mode (default): bundled fixtures, no credentials required.
MOCK_ENABLED=true

# Laximo SOAP (AXAM) - required when MOCK_ENABLED=false
LAXIMO_ENDPOINT=https://axam.laximo.com/soap/
LAXIMO_USERNAME=
LAXIMO_PASSWORD=
LAXIMO_TRADE_ID=
LAXIMO_MARKET=RU

# ABCP cart (Emex-compatible REST)
ABCP_ENABLED=true
ABCP_API_KEY=
ABCP_BASE_URL=https://api.abcp.ru

# ----------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------
# Cache TTLs - Laximo bills per call, so these are the cost knobs
# ----------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_VIN=72h
CACHE_TTL_BRANDS=720h
CACHE_TTL_MODELS=336h
CACHE_TTL_MODS=336h
CACHE_TTL_CATALOG=168h
CACHE_TTL_OEM=24h
CACHE_TTL_CROSS=6h

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
LOG_LEVEL=INFO
