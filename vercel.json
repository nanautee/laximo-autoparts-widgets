  "framework": null,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    },
    "api/[[...path]].js": {
      "runtime": "nodejs22.x"
    }
  }
}
